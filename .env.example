# Copy this file to .env and replace the placeholders.
# Do not commit .env or expose these values through VITE_ variables.

# Use DATABASE_URL for Neon deployments.
DATABASE_URL=

# Use these variables for local PostgreSQL instead of DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybershield_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
MONGODB_URI=mongodb://localhost:27017/cybershield
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000

# Comma-separated Vercel origin(s); local origins are always allowed.
FRONTEND_URL=https://your-project.vercel.app

# Frontend-only variable for Vercel; set in Vercel, not in this backend file.
# VITE_API_URL=https://your-backend.onrender.com/api
